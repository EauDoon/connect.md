# Copy to .env on the VPS. Values below are deliberately invalid production values.
# Any other value disables the production preflight and must never be used on a public host.
CONNECTMD_ENVIRONMENT=production
# Generate every database password independently with: openssl rand -hex 32
POSTGRES_DB=connectmd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-to-a-unique-hex-secret
CONNECTMD_MIGRATOR_DB_PASSWORD=change-this-migrator-password-to-independent-hex
CONNECTMD_API_DB_PASSWORD=change-this-api-password-to-independent-hex
CONNECTMD_PROJECTION_ADMIN_DB_PASSWORD=change-this-projection-admin-password-to-independent-hex
CONNECTMD_ACCOUNT_ERASURE_DB_PASSWORD=change-this-erasure-password-to-independent-hex
CONNECTMD_BACKUP_DB_PASSWORD=change-this-backup-password-to-independent-hex
MEILI_MASTER_KEY=change-this-to-a-unique-hex-secret
# Pre-provision the two required index-scoped runtime keys with the exact actions
# documented in docs/deployment.md. The delete-only key remains blank unless the
# default-disabled account lifecycle is explicitly enabled.
CONNECTMD_MEILISEARCH_SEARCH_KEY=change-this-to-a-search-only-key
CONNECTMD_SEARCH_PROJECTION_MEILI_KEY=change-this-to-a-projection-only-key
CONNECTMD_ACCOUNT_ERASURE_MEILI_KEY=
CONNECTMD_SEARCH_PROJECTION_DB_PASSWORD=change-this-to-a-unique-hex-secret

# Clerk validation inputs are consumed only by the API container. The example
# Clerk hostnames below are rejected by production preflight until replaced. The
# authorized parties value is JSON because it is parsed as a list by the API settings model.
# For an explicit public-only release, blank the JWKS URL, issuer, and audience,
# set authorized parties to [], and blank both frontend Clerk keys below. Partial
# Clerk configuration is rejected; account lifecycle cannot run in public-only mode.
CONNECTMD_CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CONNECTMD_CLERK_ISSUER=https://example.clerk.accounts.dev
# Leave blank for normal Clerk session tokens. Set only when the frontend requests
# a Clerk JWT template whose `aud` claim exactly matches this value.
CONNECTMD_CLERK_AUDIENCE=
CONNECTMD_CLERK_AUTHORIZED_PARTIES=["https://connectmd.example.com"]
CONNECTMD_API_KEY_PEPPER=change-this-to-a-unique-hex-secret
CONNECTMD_CORS_ORIGINS=[]
CONNECTMD_PUBLIC_BASE_URL=https://connectmd.example.com

# Production trust decisions use pre-provisioned internal authorities. The IDs
# are non-secret, but the placeholders must be replaced; roles are fixed.
CONNECTMD_VERIFICATION_REVIEWER_ID=replace-me-verification-reviewer
CONNECTMD_VERIFICATION_REVIEWER_ROLE=recruiting_verifier
# Keep recruiting discovery, activation, publication, and application submission closed
# until the release gates in docs/trust-safety.md are independently satisfied.
CONNECTMD_RECRUITING_ENABLED=false
CONNECTMD_POST_MODERATOR_ID=replace-me-post-moderator
CONNECTMD_POST_MODERATOR_ROLE=content_moderator
CONNECTMD_APPEAL_REVIEWER_ID=replace-me-independent-appeal-reviewer
CONNECTMD_APPEAL_REVIEWER_ROLE=appeal_reviewer

# This browser-safe Clerk key is built into the frontend; it is not a server secret.
# Blank it together with CLERK_SECRET_KEY for a public-only release.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
# This Clerk key is available only to the running frontend server so its private
# route middleware can verify human sessions. Never expose it through a
# NEXT_PUBLIC_* variable, Docker build argument, client bundle, or logs.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Public deployment. CONNECTMD_DOMAIN is required before TLS can be issued.
CONNECTMD_DOMAIN=connectmd.example.com
CONNECTMD_HTTP_PORT=80
CONNECTMD_HTTPS_PORT=443
# Keep auto when this stack owns its certificate. For an existing TLS reverse
# proxy, set external, enable its labels, and bind both published ports only to
# loopback, for example CONNECTMD_HTTP_BINDING=127.0.0.1:18080:80 and
# CONNECTMD_HTTPS_BINDING=127.0.0.1::443 (an unused ephemeral host port).
CONNECTMD_TLS_MODE=auto
CONNECTMD_TRAEFIK_ENABLED=false
ACME_EMAIL=ops@example.com

# Browser calls use the same public origin by default. Do not put MEILI credentials here.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=https://connectmd.example.com
# Disabled until the lifecycle release gates in docs/account-lifecycle.md pass.
# This public build/runtime flag must remain equal to the API flag below.
NEXT_PUBLIC_ACCOUNT_LIFECYCLE_ENABLED=false

# Resource-conscious defaults for a KVM 2 instance. Increase deliberately on KVM 4.
MEILI_MAX_INDEXING_MEMORY=201326592
MEILI_MAX_INDEXING_THREADS=1
CONNECTMD_INGEST_TIMEOUT_SECONDS=45
CONNECTMD_MAX_EXTRACTED_BYTES=8388608
# Upload/write body cap. Default 10 MiB; keep at or below Nginx 12m.
CONNECTMD_MAX_UPLOAD_BYTES=10485760
# Mandate-bound agent outreach direct-peer daily cap. Allowed 1..10000.
CONNECTMD_AGENT_OUTREACH_DIRECT_PEER_DAILY_LIMIT=100
CONNECTMD_MEILISEARCH_INDEX=documents
# Exact-search cursors are signed by the first key; retain prior keys during
# rotation for at least CONNECTMD_EXACT_SEARCH_CURSOR_TTL_SECONDS. Generate a
# fresh keyring without printing any other secret:
# python3 -c 'import base64,json,secrets; print(json.dumps([{"kid":"v1","secret":base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip("=")}],separators=(",",":")))'
CONNECTMD_EXACT_SEARCH_CURSOR_KEYRING=[{"kid":"v1","secret":"replace-with-generated-base64url-secret"}]
CONNECTMD_EXACT_SEARCH_CURSOR_TTL_SECONDS=900
CONNECTMD_SEARCH_PROJECTION_WORKER_ID=search-projection-worker
CONNECTMD_SEARCH_PROJECTION_POLL_SECONDS=2
CONNECTMD_SEARCH_PROJECTION_LEASE_SECONDS=60
CONNECTMD_SEARCH_PROJECTION_MAX_ATTEMPTS=8
CONNECTMD_SEARCH_PROJECTION_MAX_BACKOFF_SECONDS=300
CONNECTMD_SEARCH_PROJECTION_MAX_HEALTHY_DEAD_LETTERS=0
CONNECTMD_SEARCH_PROJECTION_MAX_HEALTHY_BACKLOG_AGE_SECONDS=600
CONNECTMD_BACKUP_DIR=./backups
CONNECTMD_BACKUP_MIN_FREE_BYTES=2147483648
CONNECTMD_BACKUP_RETENTION_DAYS=30

# Account lifecycle remains disabled by default. The two lifecycle keys are
# stateful deletion-journal credentials and must be uniquely provisioned before
# any production deployment; Clerk credentials are required only when enabled.
CONNECTMD_ACCOUNT_LIFECYCLE_ENABLED=false
CONNECTMD_LIFECYCLE_HMAC_KEY=change-this-hmac-authority-to-a-unique-32-byte-secret
CONNECTMD_LIFECYCLE_AEAD_KEY=change-this-aead-authority-to-a-unique-32-byte-secret
# Independent monotonic head authority. Pre-create this absolute directory as
# mode 0700 owned by the dedicated deploy/runtime UID/GID 10001, keep it outside
# CONNECTMD_BACKUP_DIR, and preserve every update off-host on immutable/WORM storage.
CONNECTMD_DELETION_WITNESS_DIR=/var/lib/connectmd/deletion-head-witness
CONNECTMD_DELETION_WITNESS_HMAC_KEY=change-this-witness-authority-to-an-independent-32-byte-secret
CONNECTMD_CLERK_BACKEND_SECRET=change-this-to-a-unique-32-byte-or-longer-secret
CONNECTMD_CLERK_BACKEND_BASE_URL=https://api.clerk.com
CONNECTMD_ACCOUNT_EXPORT_MAX_BYTES=5242880
CONNECTMD_ACCOUNT_LIFECYCLE_WORKER_ID=account-lifecycle-worker
CONNECTMD_ACCOUNT_LIFECYCLE_POLL_SECONDS=10
CONNECTMD_ACCOUNT_LIFECYCLE_MAX_HEALTHY_BACKLOG=10000
CONNECTMD_ACCOUNT_LIFECYCLE_MAX_HEALTHY_DEAD_LETTERS=0
CONNECTMD_ACCOUNT_LIFECYCLE_MAX_HEALTHY_ELIGIBLE_AGE_SECONDS=600
CONNECTMD_ACCOUNT_LIFECYCLE_POLICY_VERSION=account-lifecycle-v1

# Production API health is fixed to the readiness contract; do not override it.
API_READINESS_PATH=/readyz
FRONTEND_HEALTHCHECK_PATH=/
