{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.md/schemas/platform-evidence-receipt.schema.json",
  "title": "connect.md platform evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "feature_id",
    "source_revision",
    "recorded_at",
    "reviewer",
    "target",
    "configuration_scope",
    "checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_type": {"enum": ["repository", "deployment"]},
    "feature_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "recorded_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "reviewer": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "configuration_scope": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "command", "result", "output_path", "output_sha256"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "command": {"type": "string", "minLength": 1},
          "result": {"const": "pass"},
          "output_path": {"type": "string", "pattern": "^evidence/platform/outputs/[A-Za-z0-9._/-]+$"},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
