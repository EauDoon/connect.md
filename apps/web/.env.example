# Browser requests use this origin when empty (recommended behind connect.md Nginx).
NEXT_PUBLIC_API_BASE_URL=
# Server-rendered public pages require a reachable API origin in Docker.
CONNECTMD_API_BASE_URL=http://api:8000
# Absolute public origin for canonical metadata, robots, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://connect.md
# Obtain this browser-safe publishable value from Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server runtime only. Never rename this to NEXT_PUBLIC_*, pass it as an image
# build argument, import it from a client component, or print it.
CLERK_SECRET_KEY=
