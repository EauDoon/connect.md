# Canonical production origin used by metadata, robots, sitemap, and agent links.
NEXT_PUBLIC_SITE_URL=https://connect-md.vercel.app

# Network MVP database (PostgreSQL). Values must be resolved at deploy time;
# in production the operator stores the URL in the vault (gringotts) and
# injects it during deployment — a gringotts:// reference here deliberately
# fails closed. Local development uses a plain postgres:// URL.
CONNECTMD_NETWORK_DATABASE_URL=postgres://localhost:5432/connectmd_network_dev
