# Gringotts references for the connect.md network deployment.
#
# This file intentionally contains ONLY gringotts:// references — never
# secret values. Resolve them at deploy time with:
#
#   gringotts run --env-file deploy/gringotts.env -- <deploy command>
#
# which injects the resolved values into that command's environment only.
# The vault stores the values; this file stays commit-safe.

CONNECTMD_NETWORK_DATABASE_URL=gringotts://apps/connectmd/network-database-url
